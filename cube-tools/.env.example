# Cube REST API
CUBE_API_URL=http://127.0.0.1:4000/cubejs-api/v1

# Optional. Only needed when Cube auth is enabled.
# CUBE_API_TOKEN=

# Optional comma-separated allowlist. Leave empty to expose all public cubes.
CUBE_ALLOWED_CUBES=dim_customers,earthquakes,earthquakes_daily,airports,routes

# Local tool server
TOOLS_HOST=127.0.0.1
TOOLS_PORT=4100
MAX_ROWS=1000

# Example client only
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-chat
